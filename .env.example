# MongoDB Atlas (create a database user and allow your deployment's network access)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/stewardbridge?retryWrites=true&w=majority
MONGODB_DATABASE=stewardbridge

# NextAuth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=https://your-production-domain.example
ADMIN_EMAIL=admin@example.com

# External agent - the agent itself is NOT bundled in this repository
STEWARD_BRIDGE_AGENT_WEBHOOK_URL=https://your-agent.example/webhook
STEWARD_BRIDGE_AGENT_WEBHOOK_SECRET=replace-with-random-secret-at-least-32-characters
STEWARD_BRIDGE_AGENT_OWNER_USER_IDS=

# Optional Google OAuth provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional OpenRouter fallback for the internal AI route
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Private S3-compatible object storage for CVs and documents (Cloudflare R2 recommended)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=stewardbridge-private-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

PUBLIC_CONTACT_EMAIL=elubodetimothy@gmail.com
PUBLIC_CONTACT_WHATSAPP=2347066510205
PUBLIC_COVERAGE=Nationwide
RESEND_API_KEY=
EMAIL_FROM=
SIGNIN_ALERT_EMAIL=elubodetimothy@gmail.com
STEWARD_BRIDGE_EVENTS_WEBHOOK_URL=
STEWARD_BRIDGE_EVENTS_SIGNING_SECRET=
